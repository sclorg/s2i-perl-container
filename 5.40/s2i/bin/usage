#!/bin/sh

DISTRO=`cat /etc/*-release | grep ^ID= | grep -Po '".*?"' | tr -d '"'`

cat <<EOF
This is a S2I perl-5.40 ${DISTRO} base image:
There are multiple ways how to run the image, see documentation at:
https://github.com/sclorg/s2i-perl-container/blob/master/5.40/README.md

To use it in Openshift, run:

oc new-app perl:5.40~https://github.com/sclorg/s2i-perl-container.git --context-dir=5.40/test/sample-test-app/

You can then run the resulting image via:
oc get pods
oc exec <pod> -- curl 127.0.0.1:8080
EOF
